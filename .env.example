# Copia a .env (no se sube a git) y en Vercel crea las mismas variables.
# Clave gratuita de USDA FoodData Central: https://fdc.nal.usda.gov/api-key-signup
# Solo la usa la función serverless /api/usda-search; nunca llega al navegador.
USDA_API_KEY=

# Clave de la API de Gemini (https://aistudio.google.com/apikey): la usa /api/photo-estimate
# (foto del plato → calorías). Solo en el servidor; nunca con prefijo VITE_.
# En producción, con facturación activada (el plan gratuito no se permite para usuarios de la UE).
GEMINI_API_KEY=
# Opcional: modelo (por defecto gemini-3.5-flash-lite).
GEMINI_MODEL=
